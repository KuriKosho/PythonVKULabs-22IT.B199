/* GLOBAL */
QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
    color: #111827;
    background-color: #f3f4f6;
}

/* ===== LOGIN CARD ===== */
#LoginCard {
    background-color: #ffffff;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
}

/* ===== TITLE ===== */
#LoginTitle {
    font-size: 26px;
    font-weight: 700;
    color: #111827;
    background: none;
}

#LoginSubtitle {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 15px;
    background: none;

}
/* ===== LOGO ===== */
#AppLogo {
    margin-bottom: 6px;
    background: none;

}

#AppName {
    font-size: 16px;
    font-weight: 600;
    color: #2563eb;
    margin-bottom: 10px;
    background: none;

}

/* ===== INPUTS ===== */
QLineEdit {
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    background-color: #f9fafb;
}

QLineEdit:focus {
    border: 1px solid #2563eb;
    background-color: #ffffff;
}

/* ===== BUTTONS ===== */
#BtnPrimary {
    background-color: #2563eb;
    color: white;
    border: none;
    padding: 12px;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
}

#BtnPrimary:hover {
    background-color: #1d4ed8;
}

#BtnPrimary:pressed {
    background-color: #1e40af;
}

#BtnSecondary {
    background-color: transparent;
    color: #2563eb;
    border: 1px solid #2563eb;
    padding: 11px;
    border-radius: 8px;
    font-size: 14px;
}

#BtnSecondary:hover {
    background-color: #eff6ff;
}

/* SIDEBAR */
#Sidebar {
    background-color: #2c3e50;
    border: none;
}
#SidebarLogo {
    font-size: 20px;
    font-weight: bold;
    color: #ecf0f1;
    padding: 10px;
    background: none;
}
#NavButton {
    background-color: transparent;
    color: #bdc3c7;
    text-align: left;
    padding: 12px 20px;
    border: none;
    font-size: 15px;
}
#NavButton:hover {
    background-color: #34495e;
    color: #fff;
}
#NavButton:checked {
    background-color: #3498db;
    color: #fff;
    border-left: 5px solid #ecf0f1;
    font-weight: bold;
}
#BtnLogout {
    background-color: #c0392b;
    color: white;
    padding: 10px;
    margin: 10px;
    border-radius: 5px;
    border: none;
}
#BtnLogout:hover {
    background-color: #e74c3c;
}

/* MAIN CONTENT AREA */
QMainWindow {
    background-color: #ecf0f1;
}

/* TABLE STYLES */
QTableWidget {
    background-color: white;
    border: 1px solid #ddd;
    gridline-color: #eee;
    font-size: 13px;
}
QHeaderView::section {
    background-color: #f2f2f2;
    padding: 8px;
    border: none;
    font-weight: bold;
    color: #555;
    border-bottom: 1px solid #ccc;
}
QTableWidget::item {
    padding: 5px;
}
QTableWidget::item:selected {
    background-color: #e8f6fe;
    color: #333;
}